# ============================================
# 环境变量模板：复制为 .env.production（生产）或 .env.local（开发）
# 标注【必填】的部署时必须填，【可选】的可留空
# 注意：.env* 已在 .gitignore，绝不能提交到 git
# ============================================

# ---- MySQL（【必填】）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=health_cert
DB_USER=health
DB_PASSWORD=
DB_TIMEZONE=+08:00
DB_POOL_MAX=10

# ---- 登录 Token 密钥（【必填】生产必须填长随机串）----
# 生成命令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- 一级后台密码（【必填】生产必须填；开发留空=免密）----
ADMIN_PASSWORD=YuGuo13792580

# ---- 公网域名（【必填】生产填 https://你的域名）----
# 扫码打开的健康证链接由此生成；Nginx 透传正确时也可用请求头还原，这是兜底
DOMAIN=https://your-domain.com

# ---- 验真子域名（生产必填；本地留空=二维码指向本机，方便联调）----
# 二维码内容为 VERIFY_DOMAIN/v/随机Token
VERIFY_DOMAIN=https://verify.monetyg-health.com

# ---- 服务端口（【可选】默认3000，宝塔/PM2 里以这里为准）----
PORT=3000

# ---- 上传目录（【可选】默认项目内 public/uploads）----
# 宝塔部署建议填项目外的固定目录，避免重新发布代码覆盖照片
# 例如：UPLOAD_DIR=/www/wwwroot/health-data/uploads
UPLOAD_DIR=

# ---- 腾讯云 COS（【可选】四项齐全才启用；留空=图片存本地磁盘）----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
